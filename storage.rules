rules_version = '2';

// Firebase Storage security rules for Tape.
//
// Layout written by `FirebaseStorageService`:
//   videos/{uid}/{uuid}.{mov|mp4}
//   thumbnails/{uid}/{uuid}.jpg
//   profileImages/{uid}/{uuid}.jpg
//
// `{uid}` is the Firebase Auth uid, which is also the primary key of the
// backend `users` table, so `request.auth.uid == uid` is the ownership check.
//
// Reads are open to any signed-in user because coaches and brands browse other
// athletes' clips. Writes are restricted to the owner's own folder.
//
// Deploy: Firebase console -> Storage -> Rules -> paste -> Publish
//     or: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    match /videos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 300 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    match /thumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /profileImages/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Anything not matched above stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
